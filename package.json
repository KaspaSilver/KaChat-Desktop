{
  "name": "kaspa-engine",
  "version": "5.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bash tools/check-wasm.sh && vite --host 0.0.0.0",
    "setup:wasm": "bash tools/setup-wasm-from-rusty-zip.sh",
    "setup:cipher": "bash tools/setup-kasia-cipher.sh",
    "setup:all": "npm run setup:wasm && npm run setup:cipher",
    "build": "bash tools/check-wasm.sh && vite build",
    "build:desktop-origin": "bash tools/check-wasm.sh && vite build --base=/",
    "build:desktop-subpath": "bash tools/check-wasm.sh && vite build --base=/desktop/",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "npm run build && npm run preview"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "vite": "^8.1.4"
  }
}
