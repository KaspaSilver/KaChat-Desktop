{
  "name": "kaspa-engine",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash tools/check-wasm.sh && vite --host 0.0.0.0",
    "setup:wasm": "bash tools/setup-wasm-from-rusty-zip.sh",
    "setup:cipher": "bash tools/setup-kasia-cipher.sh",
    "setup:all": "npm run setup:wasm && npm run setup:cipher",
    "build": "bash tools/check-wasm.sh && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "npm run build && npm run preview",
    "ext:build": "bash tools/check-wasm.sh && vite build --config extension/vite.config.mjs",
    "ext:watch": "bash tools/check-wasm.sh && vite build --watch --config extension/vite.config.mjs",
    "ext:package": "npm run ext:build && node tools/ext-package.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@vitejs/plugin-basic-ssl": "latest",
    "jsqr": "^1.4.0",
    "qrcode": "latest",
    "vite": "latest"
  }
}
