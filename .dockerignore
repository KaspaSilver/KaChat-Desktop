# Keep the build context small and free of anything that should not be baked
# into an image.

# Reinstalled inside the image, and a host copy would be the wrong platform.
node_modules/
dist/
.rusty-build/

# A .env copied in here would put its settings inside the image for anyone who
# pulls it. Pass them at run time instead (`-e NAME=...`).
.env
.env.*
!.env.example

.git/
.gitignore
.claude/

*.log
*.tmp
.DS_Store
